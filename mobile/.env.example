# OPTIONAL. The app already uses the deployed backend
# (https://daniel-cluff.cnh.radarhq.io) by default; see src/config.ts.
# Only create mobile/.env to point at a LOCAL backend, then restart `npx expo start`.
# EXPO_PUBLIC_* values are inlined into the app bundle and are PUBLIC: never put API keys here.
# EXPO_PUBLIC_BACKEND_URL=http://192.168.1.10:8787
