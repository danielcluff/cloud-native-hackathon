# Copy to server/.env (gitignored). Server-only: NEVER put these in the mobile app.
PORT=8787
HOST=0.0.0.0
# OpenAI key: used for obstacle checks (Decisions), transcription, and planning.
OPENAI_API_KEY=sk-REPLACE_ME
# Optional model overrides (defaults per OpenAI docs as of 2026-11-09).
# OPENAI_VISION_MODEL=gpt-6-luna
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_TEXT_MODEL=gpt-6.1-sol
# Planning reasoning effort: low (default, ~3-5s/turn) or 'default' for the model's own (~7s/turn).
# OPENAI_TEXT_REASONING_EFFORT=low

# Pairing token: when set, every /v1/* request needs `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32   (leave unset for local development)
# APP_ACCESS_TOKEN=REPLACE_ME
# Caps on paid AI calls (defaults shown).
# LIMIT_VISION_PER_MINUTE=70
# LIMIT_VISION_PER_DAY=3000
# LIMIT_VOICE_PER_MINUTE=10
# LIMIT_VOICE_PER_DAY=300
